<%- include('partials/head', { title }) %>
<main class="login-shell">
  <section class="login-story">
    <div>
      <p class="eyebrow">Seasonal Italian dining</p>
      <h1>Saffron <span>&</span> Stone</h1>
      <p class="lead">Reserve a table, browse the kitchen's current menu, or manage daily restaurant operations.</p>
    </div>
    <% if (demoLoginAvailable) { %>
      <div class="login-demo card border-0">
        <div class="card-body">
          <p class="eyebrow mb-1">One-click demo access</p>
          <p class="demo-help">Skip the form and open a prepared role workspace.</p>
          <div class="demo-account">
            <div><strong>Customer 1</strong><code>customer1</code></div>
            <form action="/login" method="post">
              <input type="hidden" name="username" value="customer1">
              <input type="hidden" name="password" value="Customer@123">
              <button class="btn btn-sm btn-dark" type="submit">Open Customer 1</button>
            </form>
          </div>
          <div class="demo-account">
            <div><strong>Customer 2</strong><code>customer2</code></div>
            <form action="/login" method="post">
              <input type="hidden" name="username" value="customer2">
              <input type="hidden" name="password" value="Customer2@123">
              <button class="btn btn-sm btn-dark" type="submit">Open Customer 2</button>
            </form>
          </div>
          <div class="demo-account">
            <div><strong>Staff 1</strong><code>staff1 · Branch 1</code></div>
            <form action="/login" method="post">
              <input type="hidden" name="username" value="staff1">
              <input type="hidden" name="password" value="Staff@123">
              <button class="btn btn-sm btn-dark" type="submit">Open Staff 1</button>
            </form>
          </div>
          <div class="demo-account">
            <div><strong>Staff 2</strong><code>staff2 · Branch 2</code></div>
            <form action="/login" method="post">
              <input type="hidden" name="username" value="staff2">
              <input type="hidden" name="password" value="Staff2@123">
              <button class="btn btn-sm btn-dark" type="submit">Open Staff 2</button>
            </form>
          </div>
          <div class="demo-account">
            <div><strong>Admin</strong><code>admin1</code></div>
            <form action="/login" method="post">
              <input type="hidden" name="username" value="admin1">
              <input type="hidden" name="password" value="Admin@123">
              <button class="btn btn-sm btn-dark" type="submit">Open Admin</button>
            </form>
          </div>
        </div>
      </div>
    <% } %>
  </section>
  <section class="login-panel">
    <div class="login-form-wrap">
      <p class="eyebrow">Welcome back</p>
      <h2>Sign in</h2>
      <%- include('partials/flash') %>
      <form action="/login" method="post" class="vstack gap-3">
        <div>
          <label class="form-label" for="username">Username</label>
          <input class="form-control form-control-lg" id="username" name="username" autocomplete="username" required>
        </div>
        <div>
          <label class="form-label" for="password">Password</label>
          <input class="form-control form-control-lg" id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button class="btn btn-primary btn-lg w-100" type="submit">Enter Saffron & Stone</button>
      </form>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
