<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>
<main class="container page-shell">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Account security</p>
      <h1>Change password</h1>
      <p>Update the password used for your Saffron & Stone account.</p>
    </div>
  </div>
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <section class="surface-card">
        <%- include('partials/flash') %>
        <form action="/account/password" method="post" class="vstack gap-3">
          <div>
            <label class="form-label" for="currentPassword">Current password</label>
            <input class="form-control" id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required>
          </div>
          <div>
            <label class="form-label" for="newPassword">New password</label>
            <input class="form-control" id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="6" required>
          </div>
          <div>
            <label class="form-label" for="confirmPassword">Confirm new password</label>
            <input class="form-control" id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="6" required>
          </div>
          <button class="btn btn-primary" type="submit">Update password</button>
        </form>
      </section>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
